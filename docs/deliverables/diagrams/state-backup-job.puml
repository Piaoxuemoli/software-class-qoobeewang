@startuml state-backup-job
!theme plain
title 任务状态图（jobStore；备份与加密还原）

[*] --> Idle
Idle --> Editing : 选择源目录
Editing --> Editing : 修改筛选/选项\n（触发 dry-run 预览）
Editing --> Ready : 表单校验通过
Ready --> Editing : 修改
Ready --> Running : 开始备份，\n或还原未加密备份
Ready --> AwaitingPassword : 还原加密备份
AwaitingPassword --> Running : 提交口令
AwaitingPassword --> Ready : 关闭对话框

state Running {
  [*] --> Scanning
  Scanning --> Processing : 收到首个 phase=pack 进度
}
Running --> Cancelling : 用户取消
Cancelling --> Cancelled : 后端退出（E_CANCELLED，退出码 4）
Running --> Succeeded : result 事件
Running --> Failed : error（非口令类） / 非零退出
Running --> AwaitingPassword : 还原口令类错误（E_AUTH / E_PASSWORD_REQUIRED，\n未满 3 次）
Running --> Ready : 还原连续 3 次口令错误（E_AUTH）
Succeeded --> Idle : 再次备份
Failed --> Ready : 重试
Cancelled --> Ready : 返回
@enduml
