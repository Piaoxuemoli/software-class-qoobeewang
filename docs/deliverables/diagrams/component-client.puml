@startuml component-client
!theme plain
skinparam nodesep 14
skinparam ranksep 16
title 客户端子系统构件图（client/src）

package "main 进程" {
  [main/index.ts\n启动入口] as mindex
  [main/window.ts\n窗口控制 IPC] as mwindow
  [main/backend/\nspawn/JSONL/jobs] as mbackend
  [main/ipc/\nzod 校验处理器] as mipc
}
package "preload" {
  [preload/index.ts\ncontextBridge] as pre
}
package "renderer" {
  [stores/jobStore] as jobStore
  [stores/backupsStore] as backupsStore
  [stores/appStore] as appStore
  [pages/备份] as pBackup
  [pages/管理备份数据] as pManage
  [pages/备份设置] as pSettings
  [shared/protocol.ts\napi.ts] as shared <<frozen>>
}
[databackup CLI] as cli <<external>>

mindex ..> mwindow : 创建窗口并注册控制
mindex ..> mipc : 注册 IPC 处理器
mindex ..> mbackend : 装配 runner / jobs
pBackup ..> jobStore
pManage ..> backupsStore
pSettings ..> appStore
jobStore ..> pre : backup.start / cancel 等
backupsStore ..> pre : repo.list / info / remove
appStore ..> pre : config.get / set
pBackup ..> shared
pManage ..> shared
pre ..> mipc : ipcRenderer.invoke / on
pre ..> mwindow : ipcRenderer（min / max / close）
mipc ..> mbackend : jobs 运行 / 订阅事件
mbackend ..> cli : spawn + stdin 口令\nstdout JSONL → 事件推送
@enduml
