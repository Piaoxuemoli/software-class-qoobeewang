@startuml seq-backup
!theme plain
title 顺序图：客户端发起加密备份（UC-01 + UC-02 + UC-04）

actor 用户 as U
participant "renderer\n备份页" as R
participant "preload" as P
participant "main\nbackend/" as M
participant "databackup CLI" as C
participant "engine" as E
participant "walk/filter" as W
participant "pack→huffman→container" as D
participant "仓库目录\n.dbk" as RE

U -> R : 选源目录、过滤条件、\n压缩=huffman、加密=aes256、口令
R -> P : backup.start(opts, password)
P -> M : ipcRenderer.invoke
M -> C : spawn databackup ~--json backup ~--encrypt aes256 ~--password-stdin ...
M -> C : stdin: <password>\n
C -> E : Backup(ctx, BackupOptions, reporter)
E -> W : Walk（scan 阶段）
W --> E : 统计 Files/Dirs/Bytes
E --> C : reporter.Progress
C --> M : stdout JSONL\nprogress{phase:"scan"}
E -> D : container.NewWriter(w, Header, password)\n→ huffman.NewWriter → pack.NewWriter
loop 逐条 FileInfo
  E -> D : WriteHeader + Write
  D -> D : pack 头记录→huffman 压缩→AES-CBC 加密
  D -> RE : 顺序写 <name>.dbk.partial
  E --> C : reporter.Progress
  C --> M : stdout JSONL\nprogress{phase:"pack",files,bytes,total*}
end
E -> D : pack.Close → huffman.Close → container.Writer.Finish(Summary)
D -> RE : 写尾部统计 + HMAC 校验值
E -> RE : 硬链接原子发布 .partial → .dbk
E --> C : BackupResult
C --> M : stdout JSONL\nresult{command:"backup",...}
C --> M : exit 0
M --> R : 解析 JSONL 后回填完成
@enduml
