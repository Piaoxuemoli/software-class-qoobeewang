@startuml seq-list-delete
!theme plain
title 顺序图：查看备份列表与删除（UC-05、UC-06）

actor 用户 as U
participant "renderer\n管理页" as R
participant "main\nbackend/" as M
participant "databackup CLI" as C
participant "repo" as RE
participant "container" as CT

U -> R : 打开"管理备份数据"页
R -> M : repo.list()
M -> C : spawn databackup ~--json list ~--repo DIR
C -> RE : List()
loop 每个 .dbk 文件
  RE -> CT : ReadInfo（头+尾，不加载负载）
  CT --> RE : Info 或 corrupt 标记
end
RE --> C : []Backup（按创建时间降序、名字升序）
C --> M : stdout JSONL\nresult{command:"list",backups:[...]}
M --> R : 解析 JSONL 后回填列表

U -> R : 查看某备份详情
R -> M : repo.info(name)
M -> C : spawn databackup ~--json info NAME ~--repo DIR
C -> RE : Info()
RE -> CT : ReadInfo（头+尾，不校验完整负载）
CT --> RE : Info
RE --> C : Backup
C --> M : stdout JSONL\nresult{command:"info",...}
M --> R : 解析 JSONL 后显示详情

U -> R : 长按"删除"约 1.2 秒
R -> M : repo.remove(name)
M -> C : spawn databackup ~--json delete NAME ~--repo DIR
C -> RE : Delete（只接受 .dbk）
RE --> C : 已删除 Backup
C --> M : stdout JSONL\nresult{command:"delete",...}
M --> R : 解析 JSONL 后从列表移除
@enduml
