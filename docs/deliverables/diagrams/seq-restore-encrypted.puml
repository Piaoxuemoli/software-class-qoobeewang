@startuml seq-restore-encrypted
!theme plain
title 顺序图：还原加密备份（UC-03 + UC-04，含口令错误重试）

actor 用户 as U
participant "renderer\n管理页" as R
participant "main\nbackend/" as M
participant "databackup CLI" as C
participant "engine" as E
participant "container\n(HMAC 校验)" as CT
participant "huffman→pack" as D
participant "目标目录" as T

U -> R : 选择加密备份 → 还原 → 输入口令
R -> M : restore.start(backup, target, password)
M -> C : spawn databackup ~--json restore ~--backup N ~--target T ~--password-stdin
M -> C : stdin: <password>\n
C -> C : repo.Resolve(名称→路径)
C -> E : Restore(ctx, RestoreOptions, reporter)
E -> T : 检查目标目录
alt 目标已存在且非空（或不是目录）
  E --> C : ErrTargetNotEmpty
  C --> M : stdout JSONL\nerror{code:"E_TARGET_NOT_EMPTY"}，退出码 1
  M --> R : 提示更换目标目录（不写任何文件）
else 目标不存在或为空
  E -> CT : Open(r, password)（读头：盐/IV/迭代轮数 → PBKDF2 → HMAC）
  alt HMAC 校验失败（口令错误或篡改）
    CT --> E : ErrAuth
    E --> C : ErrAuth
    C --> M : stdout JSONL\nerror{code:"E_AUTH"}，退出码 3
    M --> R : 回到 AwaitingPassword，提示"口令错误"\n（连续 3 次失败回 Ready）
  else 校验通过
    CT --> E : 返回 *Reader（负载明文）
    E -> D : 逐条读取（AES-CBC 解密 → huffman 解压 → pack 条目）
    loop 每条目
      alt 路径含 ".."、绝对路径等（ErrUnsafePath）
        D --> E : ErrUnsafePath，中止还原
        E --> C : ErrUnsafePath
        C --> M : stdout JSONL\nerror{code:"E_CORRUPT"}，退出码 1
        M --> R : 还原失败（不再写后续条目）
      else 路径合法
        D -> T : 按类型重建节点 + 元数据
        E --> C : reporter.Progress
        C --> M : stdout JSONL\nprogress{phase:"restore"}
      end
    end
    E --> C : RestoreResult
    C --> M : stdout JSONL\nresult{command:"restore",...}
    C --> M : exit 0
    M --> R : 解析 JSONL 后完成
  end
end
@enduml
